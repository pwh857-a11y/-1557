sub ITEM_OPEN {

	open(IN,"$ITEM_LIST") or &ERR('  ʾҽϴ.');
	while(<IN>){
		($id,$name,$rare,$price,$str,$int,$lea,$cha) = split(/<>/,$_);
		$itemname[$id] = $name;
		$itemrare[$id] = $rare;
		$itemprice[$id] = $price;
		$itemstr[$id] = $str;
		$itemint[$id] = $int;
		$itemlea[$id] = $lea;
		$itemcha[$id] = $cha;
	}
	close(IN);
}

