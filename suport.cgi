	exit;
}

sub F_LOCK {

	$qhit=0;
	for($qp=0;$qp<1;$qp++){
		if (-d $lockfile) {
			$qhit=1;
			sleep(1);
			last;
 		}else{
			mkdir($lockfile, 0755);
		}
	}

	if($qhit){
     	&UNLOCK_FILE();
	 	&ERR("File lock error!<BR> Դϴ. ø ٷ ּ.");
	}

}

sub UNLOCK_FILE
{
  rmdir("$lockfile");
}

