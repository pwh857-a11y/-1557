sub BATTLE_LOG {

	if($lockkey) { &F_LOCK; }
	open(IN,"$BATTLE_LOG_LIST");
	@S_MOVE = <IN>;
	close(IN);

	unshift(@S_MOVE,"$_[0]\n");

	splice(@S_MOVE,150);

	open(OUT,">$BATTLE_LOG_LIST") or &ERR2('LOG ο ͸   ϴ.');
	print OUT @S_MOVE;
	close(OUT);
	if (-d $lockfile) { &UNLOCK_FILE; }

}


