sub SERVER_STOP {

	&HOST_NAME;
	open(GUEST,"./log_file/stop.cgi") or &ERR2('  ʾҽϴ.');
	@STOP=<GUEST>;close(GUEST);
if($host eq ""){&ERR("ȣƮ ȿϰ ּ.");}
	$times = time();@m_list = ();$hit=0;@New_stop=();
	$phit=0;
	foreach (@STOP){
		($stimer,$shost) = split(/<>/);
		if( $times - 180 > $stimer){
			next;
		}elsif($shost eq $host){
			if( $times-5 <= $stimer){
				$phit = 1;
			}
			push (@New_stop,"$times<>$host<>\n");
			$hit = 1;
		}else{
			push (@New_stop,"$stimer<>$shost<>\n");
		}
	}


	if(!$hit){
		push(@New_stop,"$times<>$host<>\n");
	}

	open(GUEST,">./log_file/stop.cgi") or &ERR('  ʾҽϴ.');
	print GUEST @New_stop;close(GUEST);

	if($phit){
		if($in{'id'} eq ""){
#			&ERR2("    ϰ <BR>5 ̻    ּ.<BR>Your host name : $host"); 
		}else{
#			&ERR("    ϰ <BR>5 ̻    ּ.<BR>Your host name : $host"); 
		}
	}

}


