	&CHARA_MAIN_OPEN;
	&HEADER;
	if (-d $lockfile) { &UNLOCK_FILE; }
	print "<center><hr size=0><h3>ERROR !</h3>\n";
	print "<P><font color=red><B>$_[0]</B></font>\n";
print "<form action=\"$FILE_STATUS\" method=\"post\"><input type=hidden name=id value=$kid><input type=hidden name=pass value=$kpass><input type=hidden name=mode value=STATUS><input type=submit value=\"ƿ´\"></form>";
	print "<P><hr size=0></center>\n</body></html>\n";
	exit;
}


